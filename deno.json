{
  "name": "@salmidev/dev-coach",
  "version": "0.1.2",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-run --allow-ffi cli.ts",
    "build": "deno compile --allow-read --allow-write --allow-env --allow-run --allow-ffi --output=coach cli.ts",
    "install": "deno install -g --allow-read --allow-write --allow-env --allow-run --allow-ffi --name=coach --config=deno.json cli.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-net tests/",
    "verify": "deno fmt --check && deno lint && rm -rf cov_profile && deno test --coverage=cov_profile --allow-read --allow-write --allow-env --allow-run --allow-ffi --allow-net tests/ && deno run --allow-read --allow-run scripts/check-coverage.ts cov_profile"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@0.12",
    "@std/path": "jsr:@std/path@1",
    "@std/yaml": "jsr:@std/yaml@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fs": "jsr:@std/fs@1"
  },
  "publish": {
    "include": [
      "mod.ts",
      "cli.ts",
      "src/**/*.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "fmt": {
    "lineWidth": 160,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true,
    "exclude": ["cov_profile/", "_archive/"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["cov_profile/", "_archive/"]
  }
}
